# Client: SSH must be reachable from Server.
CLIENT_SSH_BIND=0.0.0.0
CLIENT_SSH_PORT=2222
# Address and UDP port exposed on Client. Point your WG client here.
LOCAL_WG_BIND=127.0.0.1
LOCAL_WG_PORT=51820
# Must match server/.env.
BRIDGE_TCP_PORT=5980
# Internal UDP listener of wg-bridge in the container.
BRIDGE_UDP_PORT=51820
